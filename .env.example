# Copy this file to .env and keep .env private.
# Use the smallest GitHub token scope possible.
GITHUB_TOKEN=
# Multiple tokens may be comma- or newline-separated.
# GITHUB_TOKENS=token_one,token_two
GITHUB_USER_AGENT=BloomRepo/2.1 (+https://github.com/)
GITHUB_TIMEOUT_SECONDS=25

# Optional notification secrets
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
