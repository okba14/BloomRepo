# BloomRepo 3.0: all credential values are intentionally empty.
# Place a private .env beside the selected config.toml, never in version control.
# Process environment overrides .env; an empty process value can disable a channel.
# Use only the GitHub permissions needed to read public repository metadata.
GITHUB_TOKEN=
# Optional multiple tokens: comma- or newline-separated, no credentials shown here.
# GITHUB_TOKENS takes precedence over GITHUB_TOKEN within the selected layer.
# Do not enable an empty GITHUB_TOKENS entry if you intend to use GITHUB_TOKEN.
# GITHUB_TOKENS=
GITHUB_USER_AGENT=BloomRepo/3.0 (+https://github.com/)
GITHUB_TIMEOUT_SECONDS=25

# Optional external notifications; blank values leave these channels disabled.
# Webhooks must be public HTTPS, without URL userinfo/fragments; no redirects,
# localhost/private addresses, or proxy discovery. Treat the entire URL as a secret.
DISCORD_WEBHOOK_URL=
# Telegram requires BOTH fields; the token belongs to the bot you control.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Delivery is at-least-once, not exactly-once. Your receiver must durably deduplicate
# the Idempotency-Key header / JSON idempotency_key before applying side effects.
WEBHOOK_URL=

# OSV is NOT enabled here. --analyze requires --authorized; --osv separately opts
# into disclosing dependency names/versions/ecosystems to api.osv.dev. No AI is used.
